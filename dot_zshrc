# OPENSPEC:START
# OpenSpec shell completions configuration
fpath=("$HOME/.zsh/completions" $fpath)
autoload -Uz compinit
compinit
# OPENSPEC:END

# Homebrew environment (PATH, MANPATH, HOMEBREW_*). macOS-only: Linux boxes
# (devbox) have no brew. Lives here, not .zprofile, so it loads for all
# interactive shells -- including non-login ones where .zprofile is skipped
# and .zshrc's own `$(brew --prefix)` use would break.
[[ -x /opt/homebrew/bin/brew ]] && eval "$(/opt/homebrew/bin/brew shellenv zsh)"

[[ -x "$HOME/.local/bin/mise" ]] && eval "$("$HOME/.local/bin/mise" activate zsh)"
# spaceship prompt: brew path on macOS; skipped where absent (devbox uses default prompt)
[[ -n "${HOMEBREW_PREFIX:-}" && -f "$HOMEBREW_PREFIX/opt/spaceship/spaceship.zsh" ]] && \
  source "$HOMEBREW_PREFIX/opt/spaceship/spaceship.zsh"

[[ -f $HOME/.local/share/../bin/env ]] && . "$HOME/.local/share/../bin/env"

# Custom config. Must come after compinit, brew, and mise so completions
# register and the tools are on PATH.
for f in ~/.zsh/*.zsh(N); do source "$f"; done

# pnpm global bin (mise manages pnpm itself; this dir holds globally-linked CLIs)
if [[ $OSTYPE == darwin* ]]; then
  export PNPM_HOME="$HOME/Library/pnpm"
else
  export PNPM_HOME="$HOME/.local/share/pnpm"
fi
case ":$PATH:" in
  *":$PNPM_HOME/bin:"*) ;;
  *) export PATH="$PNPM_HOME/bin:$PATH" ;;
esac
# pnpm end

# zsh-autosuggestions: sourced last so it can wrap ZLE widgets defined above.
# brew path on macOS, apt path on Linux (sudo apt-get install zsh-autosuggestions).
for _zas in "${HOMEBREW_PREFIX:-/nonexistent}/share/zsh-autosuggestions/zsh-autosuggestions.zsh" \
            /usr/share/zsh-autosuggestions/zsh-autosuggestions.zsh; do
  [[ -f "$_zas" ]] && source "$_zas" && break
done
unset _zas

